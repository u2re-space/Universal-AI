{
  "name": "@u2ai/universal-ai",
  "version": "0.2.0",
  "description": "CLI-агент на OpenAI Responses API: промптинг, генерация кода/документов/картинок, автономные задачи, фоновые job'ы. Node.js 26, ESM, без SDK.",
  "type": "module",
  "main": "./index.js",
  "bin": {
    "ai": "./bin/ai.js"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "start": "node bin/ai.js",
    "test": "node --test --test-timeout=60000 \"test/*.test.js\""
  },
  "files": [
    "bin",
    "src",
    "index.js",
    "README.md"
  ],
  "keywords": [
    "openai",
    "responses-api",
    "cli",
    "agent",
    "image-generation"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@toon-format/toon": "^4.4.0",
    "@types/node": "^26.6.5",
    "really-relaxed-json": "^0.4.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3"
  },
  "allowScripts": {
    "canvas@3.2.3": true
  }
}
